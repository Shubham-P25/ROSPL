# =============================================
# SERVER - Environment Variables Example
# =============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ----- Server Configuration -----
PORT=5000

# ----- Database (MongoDB) -----
# Local MongoDB
# MONGO_URI=mongodb://localhost:27017/traveldb

# MongoDB Atlas (Cloud) - Standard Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/traveldb?retryWrites=true&w=majority

# ----- Authentication -----
# Generate a strong random secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=9f2c8e1a4b6d7f30c5e9a2b8d6f1e4c7a0b3d5e8f2c1a4b7d0e3f6a9c2b5d8e1

# ----- Weather API (OpenWeatherMap) -----
# Get your key at: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key

# ----- Flight API (Duffel) -----
# Get your key from Duffel: https://duffel.com
# Accepts Duffel test token (duffel_test_...) or live token
# Without this set, flight search falls back to sample data.
FLIGHT_API_KEY=your_flight_api_key

# ----- Visa Requirement API (optional) -----
# Without these set, the visa checker returns an "official lookup link"
# fallback instead of live data.
VISA_API_KEY=your_visa_api_key
VISA_API_URL=https://api.your-visa-provider.com/v1/check

# ----- CORS / Frontend URL -----
# URL of your deployed frontend (for CORS)
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://your-frontend.vercel.app

# ----- Email (Gmail SMTP) -----
# Contributors: Use your own Gmail App Password for local OTP testing
#
# Steps to create Gmail App Password:
#   1. Go to your Google Account → https://myaccount.google.com
#   2. Navigate to: Security → How you sign in to Google → 2-Step Verification (enable it)
#   3. After enabling, go to: Security → App passwords ( search app password )
#   4. Select app: "Mail" → Select device: "Other" → type "TravelPlanner"
#   5. Copy the 16-character password shown → paste it in EMAIL_PASS below
#
# Official Guide: https://support.google.com/accounts/answer/185833
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx


#for google login
GOOGLE_CLIENT_ID=your_google_client_id

#for places to visit
OPENTRIPMAP_API_KEY=enter_your_api_key
OPENTRIPMAP_BASE_URL=https://api.opentripmap.com/0.1
OPENTRIPMAP_LANG=en

# Reliable Trip Planner Configuration
NOMINATIM_USER_AGENT=ROSPL/1.0 (contact: packgo@example.com)
PLANNER_MAX_CONCURRENT_JOBS=3
FEATURE_HIGHLIGHTS=false
FEATURE_AI=false
YOUTUBE_API_KEY=
