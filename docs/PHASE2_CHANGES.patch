+// Parses an ISO 8601 duration like "PT2H30M" into "2h 30m". Amadeus returns
+// durations this way; the app's existing flight card shape expects a
+// human-readable string.
+function parseIsoDuration(iso) {
+  if (!iso) return "";
+  const match = /PT(?:(\d+)H)?(?:(\d+)M)?/.exec(iso);
+  if (!match) return iso;
+  const hours = match[1] ? `${match[1]}h` : "";
+  const minutes = match[2] ? `${match[2]}m` : "";
+  return [hours, minutes].filter(Boolean).join(" ") || "0m";
+}
+
+function timePartOf(isoDateTime) {
+  const match = /T(\d{2}:\d{2})/.exec(isoDateTime || "");
+  return match ? match[1] : isoDateTime;
+}
+
+// Maps a raw Amadeus flight-offer object to this app's existing flight card
+// shape, so the frontend doesn't need to know whether data came from
+// Amadeus or the mock fallback.
+function mapAmadeusFlightOffer(offer, { origin, destination, departureDate }) {
+  const firstItinerary = offer.itineraries?.[0];
+  const firstSegment = firstItinerary?.segments?.[0];
+  const lastSegment =
+    firstItinerary?.segments?.[firstItinerary.segments.length - 1];
+
+  return {
+    id: offer.id,
+    airline: firstSegment?.carrierCode || "Unknown",
+    price: Number(offer.price?.total) || 0,
+    departureTime: timePartOf(firstSegment?.departure?.at),
+    arrivalTime: timePartOf(lastSegment?.arrival?.at),
+    duration: parseIsoDuration(firstItinerary?.duration),
+    origin,
+    destination,
+    departureDate,
+    currency: offer.price?.currency || "USD",
+  };
+}
